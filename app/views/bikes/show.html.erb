<% provide(:title, "#{@bike.make} #{@bike.model}") %>
<%= link_to "← Back to bikes", bikes_path %>
<h1><%= @bike.make %> <%= @bike.model %></h1>
<p>Serial number: <%= @bike.serial_number %></p>
<p>Owner: <%= policy(@bike.customer).show? ? link_to(@bike.customer.name, @bike.customer) : @bike.customer.name %></p>

<div class="d-flex gap-2 mb-4">
  <% if policy(@bike).update? %>
    <%= link_to "Edit", edit_bike_path(@bike), class: "btn btn-outline-primary" %>
  <% end %>
  <% if policy(@bike).destroy? %>
    <%= button_to "Delete", @bike, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete bike #{@bike.serial_number} and all of its repairs? This can't be undone." } } %>
  <% end %>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
  <h2 class="mb-0">Repairs</h2>
  <% if policy(Repair).create? %>
    <%= link_to "Take in a repair", new_repair_path(bike_id: @bike.id), class: "btn btn-sm btn-primary" %>
  <% end %>
</div>
<% if @repairs.any? %>
  <table class="table table-striped">
    <thead><tr><th>Photo</th><th>Bike</th><th>Customer</th><th>Status</th><th>Promised</th><th>Diagnosis</th></tr></thead>
    <tbody><%= render @repairs %></tbody>
  </table>
<% else %>
  <p>This bike has never been in for a repair.</p>
<% end %>
