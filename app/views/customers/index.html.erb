<% provide(:title, "Customers") %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Customers</h1>
  <% if policy(Customer).create? %>
    <%= link_to "New customer", new_customer_path, class: "btn btn-primary" %>
  <% end %>
</div>
<% if @customers.any? %>
  <table class="table table-striped">
    <thead><tr><th>Name</th><th>Phone</th></tr></thead>
    <tbody><%= render @customers %></tbody>
  </table>
<% else %>
  <p>No customers yet.</p>
<% end %>
