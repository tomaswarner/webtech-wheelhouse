<% provide(:title, @customer.name) %>
<%= link_to "← Back to customers", customers_path %>
<h1><%= @customer.name %></h1>
<p>Phone: <%= @customer.phone %></p>

<div class="d-flex gap-2 mb-4">
  <%= link_to "Edit", edit_customer_path(@customer), class: "btn btn-outline-primary" %>
  <%= button_to "Delete", @customer, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete customer #{@customer.name}? This can't be undone." } } %>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
  <h2 class="mb-0">Bikes</h2>
  <%= link_to "Add a bike", new_bike_path(customer_id: @customer.id), class: "btn btn-sm btn-primary" %>
</div>
<% if @customer.bikes.any? %>
  <table class="table table-striped">
    <thead><tr><th>Bike</th><th>Serial</th><th>Owner</th></tr></thead>
    <tbody><%= render @customer.bikes %></tbody>
  </table>
<% else %>
  <p>This customer has no bikes yet.</p>
<% end %>
