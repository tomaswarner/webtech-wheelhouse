<% if object.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <p class="fw-bold mb-2"><%= pluralize(object.errors.count, "problem") %> kept this <%= object.model_name.human.downcase %> from being saved:</p>
    <ul class="mb-0">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
