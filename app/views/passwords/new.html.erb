<% provide(:title, "Forgot your password?") %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <h1>Forgot your password?</h1>
    <p>We'll email you a link to choose a new one.</p>

    <%= form_with url: passwords_path do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-control" %>
      </div>

      <%= form.submit "Email reset instructions", class: "btn btn-primary" %>
      <%= link_to "Cancel", new_session_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
</div>
