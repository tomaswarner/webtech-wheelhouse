<% provide(:title, @service_type.name) %>
<%= link_to "← Back to services", service_types_path %>
<h1><%= @service_type.name %></h1>
<p>Price: $<%= @service_type.current_price.to_i %></p>

<% if policy(@service_type).update? || policy(@service_type).destroy? %>
  <div class="d-flex gap-2 mb-4">
    <% if policy(@service_type).update? %>
      <%= link_to "Edit", edit_service_type_path(@service_type), class: "btn btn-outline-primary" %>
    <% end %>
    <% if policy(@service_type).destroy? %>
      <%= button_to "Delete", @service_type, method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete service #{@service_type.name}? This can't be undone." } } %>
    <% end %>
  </div>
<% end %>
