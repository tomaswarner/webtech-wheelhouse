<!DOCTYPE html>
<html>
  <head>
    <title>Wheelhouse</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Wheelhouse", root_path, class: "navbar-brand" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Services", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Visit", visit_path, class: "nav-link #{'active' if current_page?(visit_path)}" %>
            </li>
            <li class="nav-item">
              <%= link_to "About", about_path, class: "nav-link #{'active' if current_page?(about_path)}" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>
