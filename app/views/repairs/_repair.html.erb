<tr class="<%= "table-danger" if repair.overdue? %>">
  <td class="align-middle"><%= intake_thumbnail(repair) %></td>
  <td class="align-middle"><%= link_to "#{repair.bike.make} #{repair.bike.model}", repair %></td>
  <td class="align-middle">
    <%# Anyone who reads the repair sees the customer; only who may open the customer gets a link. %>
    <% if policy(repair.customer).show? %>
      <%= link_to repair.customer.name, repair.customer %>
    <% else %>
      <%= repair.customer.name %>
    <% end %>
  </td>
  <td class="align-middle"><%= repair.status.titleize %></td>
  <td class="align-middle"><%= repair.promised_on.strftime("%b %d, %Y") %></td>
  <td class="align-middle"><%= repair.taken_in_by ? repair.taken_in_by.display_name : "Not recorded" %></td>
  <td class="align-middle text-truncate" style="max-width: 16rem;"><%= diagnosis_excerpt(repair) %></td>
</tr>
