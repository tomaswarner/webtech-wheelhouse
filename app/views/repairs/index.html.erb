<% provide(:title, "Repairs") %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Repairs</h1>
  <% if policy(Repair).create? %>
    <%= link_to "Take in a repair", new_repair_path, class: "btn btn-primary" %>
  <% end %>
</div>
<% if @repairs.any? %>
  <table class="table table-striped">
    <thead><tr><th>Photo</th><th>Bike</th><th>Customer</th><th>Status</th><th>Promised</th><th>Taken in by</th><th>Diagnosis</th></tr></thead>
    <tbody><%= render @repairs %></tbody>
  </table>
<% else %>
  <p>No repairs yet.</p>
<% end %>
