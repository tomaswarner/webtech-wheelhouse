<% provide(:title, "Sign in") %>
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <h1>Sign in</h1>

    <%= form_with url: session_path do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :password, class: "form-label" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "form-control" %>
      </div>

      <%= form.submit "Sign in", class: "btn btn-primary" %>
    <% end %>

    <p class="mt-3 mb-1"><%= link_to "Forgot password?", new_password_path %></p>
    <p>No account yet? <%= link_to "Sign up", new_registration_path %></p>
  </div>
</div>
